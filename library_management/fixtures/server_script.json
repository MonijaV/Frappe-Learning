  "reference_doctype": "Library Member",
  "script": "if not doc.phone:\n    frappe.throw(\"Phone number is required.\")\n\nif len(str(doc.phone)) != 10:\n    frappe.throw(\"Phone number must contain exactly 10 digits.\")\n\nif doc.full_name:\n    doc.full_name = doc.full_name.upper()\n\nif doc.full_name:\n    doc.full_name = doc.full_name.strip()\n\nmember_count = frappe.db.count(\"Library Member\")\n\nfrappe.msgprint(f\"Current Library Members: {member_count}\")\n\nduplicate = frappe.db.exists(\n    \"Library Member\",\n    {\n        \"phone\": doc.phone,\n        \"name\": [\"!=\", doc.name]\n    }\n)\n\nif duplicate:\n    frappe.throw(\"Phone number already exists.\")",
  "script_type": "DocType Event"
